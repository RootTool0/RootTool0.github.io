      { "type": "code", "lang": "python", "code": "import pse\n\npse.initialize()\n\npanel = pse.Panel()\npanel.create(location=(0, 0, -100))\n\n# Анимация Front\npanel.animation = 1\n\npanel.color_on = (0, 255, 0)\npanel.color_off = (255, 0, 0)\n\n# Запустить анимацию\npanel.state = 1" },
