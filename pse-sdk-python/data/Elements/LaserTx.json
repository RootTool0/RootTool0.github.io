        ["<b><code>laser_color</code></b>", "<code>tuple[int, int, int]</code>", "чтение/запись", "Цвет лазера. RGB, <code>0..255</code>"]
      ]},
      { "type": "code", "lang": "python", "code": "import pse\n\npse.initialize()\n\ntx = pse.LaserTx()\ntx.create(location=(0, 0, -100))\n\ntx.laser_color = (255, 0, 0)  # красный лазер\ntx.shifted = False\n\n# Включить лазер\ntx.state = 1" },
      { "type": "text", "html": "<h2>Ошибки</h2>" },
