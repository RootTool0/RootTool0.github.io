          ["<b>0x00100002</b>", "PSE_COMMAND_GAME_GET_CHEATS_ENABLED", "Get the cheats enabled state", "<b>-</b>", "<code>[0]</code> <b>int8_t</b> bEnabled"],
          ["<b>0x00100003</b>", "PSE_COMMAND_GAME_SET_CHEATS_NOCLIP", "Change the noclip state in cheats mode", "<code>[0]</code> <b>int8_t</b> bNoclipEnabled", "<b>-</b>"],
