  "en": {
    "title": "Indicator",
    "blocks": [
      { "type": "image", "src": "assets/enums_h/class/PSE_CLASS_INDICATOR.png", "alt": "PSE_CLASS_INDICATOR" },
      { "type": "text", "html": "<b>PseClass:</b> <code>PSE_CLASS_INDICATOR</code> <i>(0x0007)</i>" },
      { "type": "text", "html": "<b>Element Description:</b> An indicator displaying the condition status as an icon or a circular time gauge (in timer mode)" },
      { "type": "text", "html": "<b>Set State:</b> Turns the indicator on when <b>State != 0</b> in normal mode, or starts a countdown of <b>State</b> seconds in timer mode" },
      { "type": "text", "html": "<b>Get State:</b> Not used <i>(returns <b>State</b>, initially equal to <code>0</code>)</i>" },
      { "type": "text", "html": "<b>Register layout:</b>" },
      { "type": "table", "align": ["center", "left", "left", "left"], "head": ["Index", "Name", "Data format", "Description"], "rows": [
        ["<code>[0]</code>", "<b>Flags</b>", "<code>______________________________PT</code>", "<code>P</code> - Bit that switches the indicator model to a flat one<br><code>T</code> - Bit that switches the indicator to timer mode"],
        ["<code>[1]</code>", "<b>Color Activated</b>", "<code>________RRRRRRRRGGGGGGGGBBBBBBBB</code>", "<code>R...G...B</code> - Element color in the activated (on) state"],
        ["<code>[2]</code>", "<b>Color Deactivated</b>", "<code>________RRRRRRRRGGGGGGGGBBBBBBBB</code>", "<code>R...G...B</code> - Element color in the deactivated (off) state"],
        ["<code>[3]</code>", "<b>NOT USED</b>", "<code>________________________________</code>", "<b>-</b>"],
        ["<code>[4]</code>", "<b>NOT USED</b>", "<code>________________________________</code>", "<b>-</b>"],
        ["<code>[5]</code>", "<b>NOT USED</b>", "<code>________________________________</code>", "<b>-</b>"],
        ["<code>[6]</code>", "<b>NOT USED</b>", "<code>________________________________</code>", "<b>-</b>"],
        ["<code>[7]</code>", "<b>NOT USED</b>", "<code>________________________________</code>", "<b>-</b>"]
      ]}
    ]
  }
}
