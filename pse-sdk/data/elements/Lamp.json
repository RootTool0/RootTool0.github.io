      { "type": "image", "src": "assets/enums_h/class/PSE_CLASS_LAMP.png", "alt": "PSE_CLASS_LAMP" },
      { "type": "text", "html": "<b>PseClass:</b> <code>PSE_CLASS_LAMP</code> <i>(0x0016)</i>" },
      { "type": "text", "html": "<b>Element Description:</b> A regular lamp that changes its color depending on <b>State</b>" },
      { "type": "text", "html": "<b>Set State:</b> Turns the lamp on when <b>State != 0</b>" },
      { "type": "text", "html": "<b>Get State:</b> Not used <i>(returns <b>State</b>, initially equal to <code>0</code>)</i>" },
      { "type": "text", "html": "<b>Register layout:</b>" },
      { "type": "table", "align": ["center", "left", "left", "left"], "head": ["Index", "Name", "Data format", "Description"], "rows": [
